APP_NAME="SHI STUDIO API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Frontend origin(s) allowed to call the API (comma separated). * for any.
CORS_ALLOWED_ORIGINS=*

# Where shared/content.json lives. Leave as-is inside the monorepo.
CONTENT_JSON_PATH=

# Email that receives new inquiries (leave empty to disable notifications).
INQUIRY_NOTIFY_EMAIL=vaness098a@gmail.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@shistudio.test"
MAIL_FROM_NAME="${APP_NAME}"
